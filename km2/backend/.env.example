# --- App ---
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
# Set true ONLY for local dev without Neon Auth configured yet — bypasses auth as a fixed dev user.
DEV_AUTH_BYPASS=false

# --- Database (Neon / Supabase / any Postgres with pgvector) ---
DATABASE_URL=postgresql+psycopg://user:password@host:5432/krishimitra

# --- Auth (Neon Auth — Managed Better Auth) ---
# JWKS URL for verifying Neon Auth RS256 tokens.
# Find this in your Neon project settings under Auth, or in .env.local.
NEON_AUTH_JWKS_URL=

# --- AI (Groq API) — backend only, never expose to frontend ---
GROQ_API_KEY=
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=qwen/qwen3.8-27b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# --- Weather (Open-Meteo API — free, no API key required) ---
WEATHER_PROVIDER=openmeteo


# --- Market data (e.g. data.gov.in Agmarknet) ---
MARKET_DATA_API_KEY=
MARKET_DATA_BASE_URL=

# --- Image storage: set ONE of the two blocks below ---
STORAGE_PROVIDER=cloudinary
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# STORAGE_PROVIDER=s3
# S3_BUCKET=
# S3_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60
AI_RATE_LIMIT_PER_MINUTE=15
